GNEWS_API_KEY=
NEWSDATA_API_KEY=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=estd_knowledge
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/estd_knowledge
SIMILARITY_THRESHOLD=0.82

# Public Vercel frontend origin allowed to call this backend (comma-separated if needed).
FRONTEND_URL=https://frontend-zeta-amber.vercel.app

# Step 6 MCP Integration Configuration
GDRIVE_OAUTH_PATH=credentials/gcp-oauth.keys.json
GDRIVE_CREDENTIALS_PATH=credentials/gdrive-server-credentials.json
MCP_TIMEOUT_SECONDS=20.0
MCP_READ_ONLY_ENFORCED=true

# Step 7 Gemini AI Content Generation Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_RETRIES=2
GEMINI_TIMEOUT_SECONDS=30.0

# API Security & Operations
ADMIN_API_KEY=your_secret_admin_api_key_here
ENABLE_DOCS=false
ENABLE_GDRIVE_EXPORT=false
NODE_TLS_REJECT_UNAUTHORIZED=0
# Automated Pipeline Scheduler (Set to 'on' or 'true' to start, 'off' or 'false' to stop)
ENABLE_SCHEDULER=off
SCHEDULER_INTERVAL_HOURS=2
SCHEDULER_ARTICLES_PER_CATEGORY=3
